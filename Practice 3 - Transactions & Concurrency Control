-- PART C: COMPARING LOCKING (Blocking) vs. MVCC (Non-Blocking)
-- This section re-demonstrates blocking for contrast.

-- EXPLAIN: Shows the efficiency of using the index for the locking operation.
EXPLAIN SELECT * FROM StudentEnrollments WHERE student_id = 2 FOR UPDATE;

-- Session A (Locker) locks Row 2:
START TRANSACTION;
SELECT * FROM StudentEnrollments WHERE student_id = 2 FOR UPDATE;

-- PAUSE: Run the following in Session B: 
-- UPDATE StudentEnrollments SET enrollment_date = '2024-08-01' WHERE student_id = 2; -- This will BLOCK.

-- Run COMMIT in Session A to release the lock, allowing Session B to proceed.
COMMIT; 

SELECT 'Locking Scenario Complete' AS Status, T.* FROM StudentEnrollments T;
